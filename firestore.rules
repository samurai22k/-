rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'omaratef11110@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidCity(city) {
      return city in ['Moscow', 'Saint Petersburg', 'Kazan', 'Sochi'];
    }

    function isValidPlaceCategory(cat) {
      return cat in ['restaurant', 'hotel', 'hostel', 'cafe', 'grocery', 'other'];
    }

    function isValidServiceCategory(cat) {
      return cat in ['translator', 'taxi', 'legal', 'medical', 'housing', 'other'];
    }

    function isValidAdminDoc(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'grantedBy', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120))
        && data.grantedBy is string && data.grantedBy == request.auth.uid && data.grantedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidPlace(data) {
      return data.keys().hasAll([
          'name', 'nameAr', 'category', 'city', 'address',
          'nearestMetro', 'nearestMetroAr', 'description', 'descriptionAr',
          'isHalal', 'latitude', 'longitude', 'phone', 'isActive',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'nameAr', 'category', 'city', 'address',
          'nearestMetro', 'nearestMetroAr', 'description', 'descriptionAr',
          'isHalal', 'latitude', 'longitude', 'phone', 'imageUrl', 'isActive',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 160
        && data.nameAr is string && data.nameAr.size() >= 2 && data.nameAr.size() <= 160
        && isValidPlaceCategory(data.category)
        && isValidCity(data.city)
        && data.address is string && data.address.size() >= 3 && data.address.size() <= 255
        && data.nearestMetro is string && data.nearestMetro.size() >= 2 && data.nearestMetro.size() <= 120
        && data.nearestMetroAr is string && data.nearestMetroAr.size() >= 2 && data.nearestMetroAr.size() <= 120
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 1500
        && data.descriptionAr is string && data.descriptionAr.size() >= 5 && data.descriptionAr.size() <= 1500
        && data.isHalal is bool
        && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 40
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500))
        && data.isActive is bool
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOffer(data, placeId) {
      return data.keys().hasAll([
          'placeId', 'title', 'titleAr', 'description', 'descriptionAr',
          'discountPercentage', 'promoCode', 'expiresAt', 'isActive',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'placeId', 'title', 'titleAr', 'description', 'descriptionAr',
          'discountPercentage', 'promoCode', 'expiresAt', 'isActive',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.placeId) && data.placeId == placeId
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 160
        && data.titleAr is string && data.titleAr.size() >= 3 && data.titleAr.size() <= 160
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 1000
        && data.descriptionAr is string && data.descriptionAr.size() >= 5 && data.descriptionAr.size() <= 1000
        && data.discountPercentage is int && data.discountPercentage >= 1 && data.discountPercentage <= 100
        && data.promoCode is string && data.promoCode.size() >= 2 && data.promoCode.size() <= 32
        && data.expiresAt is string && data.expiresAt.size() >= 8 && data.expiresAt.size() <= 32
        && data.isActive is bool
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidService(data) {
      return data.keys().hasAll([
          'fullName', 'fullNameAr', 'category', 'city',
          'specialty', 'specialtyAr', 'languagesSpoken', 'languagesSpokenAr',
          'phone', 'isVerified', 'isActive', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'fullName', 'fullNameAr', 'category', 'city',
          'specialty', 'specialtyAr', 'languagesSpoken', 'languagesSpokenAr',
          'phone', 'whatsappUrl', 'telegramUrl', 'isVerified', 'isActive',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 140
        && data.fullNameAr is string && data.fullNameAr.size() >= 2 && data.fullNameAr.size() <= 140
        && isValidServiceCategory(data.category)
        && isValidCity(data.city)
        && data.specialty is string && data.specialty.size() >= 3 && data.specialty.size() <= 240
        && data.specialtyAr is string && data.specialtyAr.size() >= 3 && data.specialtyAr.size() <= 240
        && data.languagesSpoken is list && data.languagesSpoken.size() >= 1 && data.languagesSpoken.size() <= 10
        && data.languagesSpoken[0] is string && data.languagesSpoken[0].size() >= 1 && data.languagesSpoken[0].size() <= 40
        && data.languagesSpokenAr is list && data.languagesSpokenAr.size() >= 1 && data.languagesSpokenAr.size() <= 10
        && data.languagesSpokenAr[0] is string && data.languagesSpokenAr[0].size() >= 1 && data.languagesSpokenAr[0].size() <= 40
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 40
        && (!('whatsappUrl' in data) || (data.whatsappUrl is string && data.whatsappUrl.size() <= 255))
        && (!('telegramUrl' in data) || (data.telegramUrl is string && data.telegramUrl.size() <= 255))
        && data.isVerified is bool
        && data.isActive is bool
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 3. Admins Allowlist Collection (zero get/exists in allow list)
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isAdmin() || (isVerifiedUser() && request.auth.uid == adminUid));
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(adminUid)
        && isValidAdminDoc(incoming())
        && incoming().uid == adminUid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminUid) && adminUid != request.auth.uid;
    }

    // 4. Collection-group public read for active Offers across Places
    match /{path=**}/offers/{offerId} {
      allow list: if true;
    }

    // 5. Places Collection (Restaurants, Hotels, Hostels, Cafes, Groceries)
    match /places/{placeId} {
      allow get: if isValidId(placeId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(placeId)
        && isValidPlace(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(placeId)
        && isValidPlace(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'nameAr', 'category', 'city', 'address',
          'nearestMetro', 'nearestMetroAr', 'description', 'descriptionAr',
          'isHalal', 'latitude', 'longitude', 'phone', 'imageUrl', 'isActive', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(placeId);

      // Master Gate Subcollection: Offers belonging to Place
      match /offers/{offerId} {
        allow get: if isValidId(placeId) && isValidId(offerId);
        allow list: if true;
        allow create: if isAdmin()
          && isValidId(placeId)
          && isValidId(offerId)
          && exists(/databases/$(database)/documents/places/$(placeId))
          && isValidOffer(incoming(), placeId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isAdmin()
          && isValidId(placeId)
          && isValidId(offerId)
          && exists(/databases/$(database)/documents/places/$(placeId))
          && isValidOffer(incoming(), placeId)
          && incoming().placeId == existing().placeId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'titleAr', 'description', 'descriptionAr',
            'discountPercentage', 'promoCode', 'expiresAt', 'isActive', 'updatedAt'
          ]);
        allow delete: if isAdmin() && isValidId(placeId) && isValidId(offerId);
      }
    }

    // 6. Services Collection (Translators, Taxis, Legal, Medical, Housing)
    match /services/{serviceId} {
      allow get: if isValidId(serviceId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(serviceId)
        && isValidService(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(serviceId)
        && isValidService(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName', 'fullNameAr', 'category', 'city',
          'specialty', 'specialtyAr', 'languagesSpoken', 'languagesSpokenAr',
          'phone', 'whatsappUrl', 'telegramUrl', 'isVerified', 'isActive', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(serviceId);
    }
  }
}
